# regenerated by reproduce.sh — not shipped
/mixlib/
/traces/*/jobs/
/calibration/shards/
/calibration/runs/
/calibration/palette.json
/calibration/lat_kvhead.txt
# 4096x4096 matrices (~50 MB each) — regenerated by `reproduce.sh configs`
/configs/bandwidth_schedule.txt
/configs/latency_schedule.txt
# pipeline scratch (probe loop, farm pool logs, smoke runs)
/probe-traces/
/smoke-traces/
/farm-logs/
# trace-tweak working area (2026-06 heavy_large retune; see tweak/SUMMARY.md)
/tweak/
/tweak-traces/
__pycache__/
.ruff_cache/
# per-run console output (run.log) and other debug logs are never kept;
# the NPU-failure manifest (failed_nodes.log) is part of a failure run's
# results and stays tracked.
run.log
*.log
!failed_nodes.log
# reports are regenerated, never committed
*.html
