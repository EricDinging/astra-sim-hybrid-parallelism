# regenerated by reproduce.sh — not shipped
/mixlib/
/calibration/runs/
/traces/*/jobs/
__pycache__/
.ruff_cache/
# per-run console output (run.log) and other debug logs are never kept;
# the NPU-failure manifest (failed_nodes.log) is part of a failure run's
# results and stays tracked.
run.log
*.log
!failed_nodes.log
